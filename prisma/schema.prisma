generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  email     String?  @unique @db.VarChar(255)
  pixKey    String?  @map("pix_key") @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")

  groups        GroupMember[]
  paidExpenses  Expense[]
  expenseSplits ExpenseSplit[]

  @@map("users")
}

model Group {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(100)
  category    String   @db.VarChar(50)
  inviteToken String   @unique @map("invite_token") @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at")

  members  GroupMember[]
  expenses Expense[]

  @@map("groups")
}

model GroupMember {
  groupId  String   @db.Uuid
  userId   String   @db.Uuid
  joinedAt DateTime @default(now()) @map("joined_at")

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@map("group_members")
}

model Expense {
  id           String   @id @default(uuid()) @db.Uuid
  groupId      String   @db.Uuid
  paidByUserId String   @map("paid_by_user_id") @db.Uuid
  amount       Decimal  @db.Decimal(10, 2)
  description  String   @db.VarChar(255)
  receiptUrl   String?  @map("receipt_url")
  createdAt    DateTime @default(now()) @map("created_at")

  group  Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  paidBy User           @relation(fields: [paidByUserId], references: [id])
  splits ExpenseSplit[]

  @@map("expenses")
}

model ExpenseSplit {
  id         String   @id @default(uuid()) @db.Uuid
  expenseId  String   @db.Uuid
  userId     String   @db.Uuid
  amountOwed Decimal  @map("amount_owed") @db.Decimal(10, 2)
  createdAt  DateTime @default(now()) @map("created_at")

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("expense_splits")
}
